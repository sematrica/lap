OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT_SECONDS=120
MAX_AGENT_ITERATIONS=10
EMAIL_DRY_RUN=true
# Leave SMTP values empty for dry runs. Fill these in only for real delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true uses STARTTLS (usually port 587), not implicit TLS on port 465.
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30

# Read-only inbox access (separate from SMTP; no automatic credential reuse).
IMAP_HOST=imap.mail.yahoo.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_TIMEOUT_SECONDS=30
# Public NASA demo key works without signup; use a personal key for higher limits.
NASA_API_KEY=DEMO_KEY
NASA_TIMEOUT_SECONDS=30
