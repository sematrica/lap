OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT_SECONDS=120
MAX_AGENT_ITERATIONS=10
EMAIL_DRY_RUN=true
# Leave SMTP values empty for dry runs. Fill these in only for real delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true uses STARTTLS (usually port 587), not implicit TLS on port 465.
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
